# Server
PORT=3001
NODE_ENV=development

# Content directory (default: ./content next to package.json)
# Leave empty in deploy — ships listening.json + listening.mp3 under content/
CONTENT_ROOT=

# MongoDB Atlas / local
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/DictationJP?retryWrites=true&w=majority

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Optional. Serve lesson mp3 from a CDN / object store instead of this server: /api/audio/:lessonId redirects
# to <AUDIO_BASE_URL>/<lessonId>.mp3. Leave empty to stream from the content folder.
AUDIO_BASE_URL=

# Optional tuning. Proxy hops to trust for the client IP (Render = 1); seconds-long cache of the signed-in user.
# TRUST_PROXY=1
# AUTH_CACHE_TTL_MS=30000

# Frontend base URL (post-login redirect)
CLIENT_URL=http://localhost:5173

# Google OAuth (Cloud Console) — never put real secrets in this file
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Sign cookies/tokens — use a long random string in production
JWT_SECRET=change-me-in-production

# Admin area (/admin). On boot, a super admin with this username is created if none exists;
# the password is only used that first time (change it later from the admin UI).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional: sign admin tokens with a different secret than JWT_SECRET
ADMIN_JWT_SECRET=

# Cloudinary — lesson images and user avatars
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Openverse API credentials (free) -- they raise the rate limits of the flashcard picture search
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# Optional: Anthropic API key for AI-written visual search phrases in flashcard picture picker
ANTHROPIC_API_KEY=

# Web Push reminders for flashcards due for review. Generate with: npx web-push generate-vapid-keys
# Reminders stay off while the keys are empty. VAPID_SUBJECT is a mailto: or https: contact for push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
