# Server
PORT=3001
NODE_ENV=development

# Content directory (default: ./content next to package.json)
# Leave empty in deploy — ships listening.json + listening.mp3 under content/
CONTENT_ROOT=

# MongoDB Atlas / local
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/DictationJP?retryWrites=true&w=majority

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Frontend base URL (post-login redirect)
CLIENT_URL=http://localhost:5173

# Google OAuth (Cloud Console) — never put real secrets in this file
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Sign cookies/tokens — use a long random string in production
JWT_SECRET=change-me-in-production

# Admin area (/admin). On boot, a super admin with this username is created if none exists;
# the password is only used that first time (change it later from the admin UI).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional: sign admin tokens with a different secret than JWT_SECRET
ADMIN_JWT_SECRET=
